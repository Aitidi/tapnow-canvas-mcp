{
  "name": "tapnow-canvas-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local MCP bridge for TapNow desktop and experimental Chrome web canvases",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "diagnose": "tsx src/cli.ts diagnose",
    "diagnose:web": "tsx src/cli.ts diagnose-web",
    "resident:start": "node dist/cli.js resident-start",
    "resident:status": "node dist/cli.js resident-status",
    "resident:stop": "node dist/cli.js resident-stop",
    "verify:resident": "tsx scripts/live-resident.ts",
    "config:codex:web": "node scripts/print-config.mjs codex --web-resident",
    "launch": "tsx src/cli.ts launch",
    "test": "tsx --test test/*.test.ts",
    "config:claude": "node scripts/print-config.mjs json",
    "config:codex": "node scripts/print-config.mjs codex",
    "config:claude-code": "node scripts/print-config.mjs claude-code"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
